# ==============================================================
# 🚀 SaaS Infrastructure Environment Configuration
# ==============================================================
# Instructions:
# 1. Copy this file: `cp .env.example .env`
# 2. Replace all placeholder passwords with secure, random strings.
# 3. Ensure this file is never committed to version control.
# ==============================================================

# --------------------------------------------------------------
# 1. Nginx Proxy Manager (Reverse Proxy Infrastructure)
# --------------------------------------------------------------
# These credentials secure the internal MariaDB instance (npm_db)
# that Nginx Proxy Manager uses to store its configuration,
# SSL certificates, and routing rules.
# --------------------------------------------------------------
NPM_DB_ROOT_PASSWORD=generate_a_secure_random_root_password_here
NPM_DB_PASSWORD=generate_a_secure_random_user_password_here

# --------------------------------------------------------------
# 2. SaaS Application Database (MySQL Business Data)
# --------------------------------------------------------------
# These credentials secure the main application database (saas_db).
# The 'api' container and 'phpmyadmin' will use these to interact
# with your business data.
# --------------------------------------------------------------
MYSQL_ROOT_PASSWORD=generate_a_secure_random_mysql_root_password_here
MYSQL_DATABASE=saas_db
MYSQL_USER=saas_user
MYSQL_PASSWORD=generate_a_secure_random_mysql_user_password_here

# --------------------------------------------------------------
# 3. Tailscale / Security Variables (Optional but Recommended)
# --------------------------------------------------------------
# If you are using Tailscale for zero-trust SSH/Admin access,
# document your host machine's Tailscale IP here for reference.
# Run `tailscale ip -4` on your server to get this.
# --------------------------------------------------------------
TAILSCALE_IP=100.x.y.z
